{
  "name": "mediator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm run dev:server\" \"npm --prefix frontend run start\"",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run build-all",
    "build:frontend": "npm --prefix frontend run build",
    "build:server": "tsc -p tsconfig.json",
    "build-all": "npm run build:server && npm run build:frontend",
    "start": "node dist/server/index.js",
    "worker:hourly": "tsx src/server/scheduled-workers/hourly/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.58.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.1",
    "nodemailer": "^7.0.10",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.6.0",
    "@types/nodemailer": "^7.0.3",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
