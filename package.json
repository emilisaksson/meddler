{
    "name": "mediator",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "install:frontend": "cd frontend && npm install --include=dev --no-fund --no-audit",
        "postinstall": "npm run install:frontend",
        "dev": "concurrently -n server,client -c blue,magenta \"npm run dev:server\" \"npm --prefix frontend run start\"",
        "dev:server": "tsx watch src/server/index.ts",
        "build": "npm run build-all",
        "build:frontend": "npm --prefix frontend run build",
        "build:server": "tsc -p tsconfig.json --noEmit && esbuild src/server/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/server/index.cjs",
        "build:all": "npm run build:server && npm run build:frontend",
        "build-all": "npm run build:all",
        "start": "node dist/server/index.cjs",
        "worker:hourly": "tsx src/server/scheduled-workers/hourly/index.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.58.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^5.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.19.1",
        "nodemailer": "^7.0.10",
        "stripe": "^20.4.1",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@angular/build": "^21.2.0",
        "@angular/cli": "^21.2.0",
        "@angular/compiler-cli": "^21.2.0",
        "@tailwindcss/postcss": "^4.1.14",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.6.0",
        "@types/nodemailer": "^7.0.3",
        "concurrently": "^9.2.1",
        "esbuild": "^0.27.4",
        "jsdom": "^28.0.0",
        "prettier": "^3.8.1",
        "tailwindcss": "^4.1.14",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "vitest": "^4.0.8"
    }
}
